MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Defaults to the current ChamaHub database to preserve existing group and account data.
CHAMAHUB_MONGODB_DB=ChamaVickinsHub
BETTER_AUTH_SECRET=generate_a_unique_random_secret_of_at_least_32_characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EMAIL_USER=
EMAIL_PASS=
# Optional custom SMTP relay. If blank, EMAIL_USER/EMAIL_PASS use Gmail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
JOBS_TOKEN=
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
DEFAULT_TIME_ZONE=Africa/Nairobi
# Leave disabled until a verified provider adapter, secure webhook endpoint, and Daraja account are configured.
MPESA_ENVIRONMENT=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
